# Copy to frontend/.env.production BEFORE building: the NEXT_PUBLIC_ values are baked into the build.
NEXT_PUBLIC_API_URL=https://api.elevendollar.store/api/v1
NEXT_PUBLIC_SITE_URL=https://elevendollar.store

# Server-only. Must equal STOREFRONT_SSR_KEY in the backend .env. Also set it in cPanel -> Setup Node.js App.
STOREFRONT_SSR_KEY=
