APP_NAME="Eleventory"
APP_ENV=production
APP_KEY=                      # generate on the server: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.elevendollar.store
FRONTEND_URL=https://elevendollar.store

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanelprefix_eleventory
DB_USERNAME=cpanelprefix_eleventory
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Shared secret: must equal STOREFRONT_SSR_KEY in the frontend env. Generate with: openssl rand -hex 24
STOREFRONT_SSR_KEY=

# Email is configured from Settings -> Notifications in the admin; this is only the fallback.
MAIL_MAILER=log
