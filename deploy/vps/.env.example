# Used by docker-compose.yml AND passed to the Laravel containers. Never commit the real one.

PLATFORM_DOMAIN=eleventory.com

APP_NAME=Eleventory
APP_KEY=                       # docker compose run --rm api php artisan key:generate --show
APP_URL=https://api.eleventory.com
FRONTEND_URL=https://eleventory.com
CORS_ALLOWED_ORIGINS=https://eleventory.com,https://app.eleventory.com

DB_CONNECTION=mysql
DB_DATABASE=eleventory
DB_USERNAME=eleventory
DB_PASSWORD=                   # openssl rand -hex 16
DB_ROOT_PASSWORD=              # openssl rand -hex 16

STOREFRONT_SSR_KEY=            # openssl rand -hex 24 (same value the web service uses)
TLS_ASK_SECRET=                # openssl rand -hex 24 (also used in the Caddyfile)

# Multi-tenant
PLATFORM_CNAME_TARGET=stores.eleventory.com
MERCHANT_SIGNUP=false
TENANT_REQUESTS_PER_MINUTE=600

# Media: keep "public" to store files on the server volume, or "s3" for S3 / Cloudflare R2 + CDN.
MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=                  # R2: https://<account>.r2.cloudflarestorage.com
AWS_URL=                       # public/CDN address of the bucket, e.g. https://media.eleventory.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# Backups (backup.sh and tenant:export)
BACKUP_ENCRYPTION_KEY=         # base64:... encrypts per-shop exports; keep a copy OFF this server
BACKUP_PASSPHRASE=             # encrypts the nightly database dump (backup.sh); keep a copy OFF this server
BACKUP_REMOTE=                 # optional rclone target, e.g. r2:eleventory-backups
BACKUP_TENANT_EXPORTS=true
BACKUP_RETENTION_DAYS=14

# Monitoring
SENTRY_LARAVEL_DSN=
MAIL_MAILER=smtp
LOG_CHANNEL=stderr
LOG_LEVEL=warning
